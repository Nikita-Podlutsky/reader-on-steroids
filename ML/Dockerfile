# Этап 1: Базовый образ и установка инструментов
# ------------------------------------------------
# Используем стабильный и легковесный образ Python.
# Убедитесь, что версия совпадает с той, что вы используете локально.
FROM python:3.13-slim

# Устанавливаем uv - быстрый менеджер пакетов.
# Делаем это отдельным слоем, чтобы он кэшировался.
RUN pip install uv


# Этап 2: Установка зависимостей проекта
# ----------------------------------------
# Устанавливаем рабочую директорию внутри контейнера.
WORKDIR /app

# Копируем только файлы с зависимостями. Docker не будет переустанавливать
# пакеты при каждом изменении вашего .py кода, что сильно ускоряет сборку.
COPY pyproject.toml uv.lock* ./

# Устанавливаем зависимости с помощью uv. Команда 'sync' гарантирует,
# что окружение будет в точности соответствовать lock-файлу.
RUN uv sync


# Этап 3: Копирование кода и файла модели
# -----------------------------------------
# Объявляем аргумент сборки. Его значение будет передано из docker-compose.yml.
# Здесь мы также задаем имя по умолчанию на случай, если аргумент не передан.
ARG MODEL_FILE_NAME=best_model.pt

# Копируем исходный код вашего приложения (папку scripts).
COPY scripts/ ./scripts/

# Создаем директорию для хранения модели внутри образа.
RUN mkdir -p /app/checkpoints

# Копируем ТОЛЬКО ОДИН файл модели, имя которого мы получили через аргумент,
# в созданную папку внутри контейнера.
COPY scripts/checkpoints_lstm/${MODEL_FILE_NAME} /app/checkpoints/


# Этап 4: Запуск приложения
# -----------------------------
# Сообщаем Docker, что приложение будет слушать этот порт.
EXPOSE 5000

# Команда, которая будет выполнена при старте контейнера.
# Убедитесь, что путь к api.py и путь к модели внутри него верные.
# Например, внутри api.py модель теперь нужно будет загружать из '/app/checkpoints/'.
CMD ["uv", "run", "scripts/api.py"]